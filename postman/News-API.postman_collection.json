{
  "info": {
    "name": "Nhiệm vụ 17 - News API",
    "description": "Chạy theo thứ tự 01–11 trên localhost. Điền ảnh tại bước 09. Chỉ có dữ liệu ví dụ; accessToken và ID được để trống khi export. Không export lại token sau khi sử dụng.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "username",
      "value": "sinhvien_demo",
      "type": "string"
    },
    {
      "key": "email",
      "value": "sinhvien@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "DemoPass123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "newsId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fileId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
              "pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Đăng ký",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
              "pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Đăng nhập",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
              "pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"accessToken\", pm.response.json().data.accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Tạo tin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/news",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Học NodeJS\",\n  \"content\": \"Nội dung bài học Express và SQLite.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
              "pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"newsId\", pm.response.json().data.news.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Danh sách public",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/news",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
              "pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Chi tiết public",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/news/{{newsId}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
              "pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Tìm kiếm, sắp xếp, phân trang",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/news?search=nodejs&sortBy=title&order=asc&page=1&limit=5",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
              "pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Sửa tin",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/news/{{newsId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Học NodeJS - đã cập nhật\",\n  \"content\": \"Nội dung bài học đã được sửa.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
              "pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Upload ảnh",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/files/upload",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
              "pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"fileId\", pm.response.json().data.file.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Xóa ảnh",
      "request": {
        "method": "DELETE",
        "header": [],
